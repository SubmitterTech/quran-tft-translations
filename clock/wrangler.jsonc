{
  "name": "quran-tft-translations-clock",
  "main": "clock.js",
  "compatibility_date": "2026-06-09",
  // The Worker answers to nothing but its own schedule: it has no address.
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  // UTC. Four times a day, at 00:19, 06:19, 12:19 and 18:19.
  "triggers": { "crons": ["19 */6 * * *"] },
  "vars": {
    "GITHUB_REPOSITORY": "SubmitterTech/quran-tft-translations",
    "GITHUB_WORKFLOW": "release.yml",
    "GITHUB_REF": "main",
    "GITHUB_APP_CLIENT_ID": "Iv23liOFY9A3edQ5MunD"
  }
  // The app's private key is the secret GITHUB_APP_PRIVATE_KEY. It is entered on Cloudflare
  // and is never written to a file here.
}
